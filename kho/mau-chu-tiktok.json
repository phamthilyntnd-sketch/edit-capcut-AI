  },
  "3": {
   "ten": "Thẻ trả lời bình luận",
   "mo_ta": "Thẻ trắng nhỏ giả bình luận khách, dòng tên xám, câu hỏi đen.",
   "capcut": "1 lớp, dòng 1 nhỏ xám, dòng 2 đen đậm, Nền chữ trắng bo góc, góc trên."
  },
  "4": {
   "ten": "Chữ có chân sang trọng",
   "mo_ta": "Tên thương hiệu serif in hoa trắng/vàng kim + dòng nhỏ giãn chữ.",
