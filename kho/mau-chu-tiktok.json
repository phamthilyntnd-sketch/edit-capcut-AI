  "6": {
   "ten": "Ghép viết tay + in đậm",
   "mo_ta": "Dòng viết tay nhỏ (màu nhấn) chồng lên dòng in hoa đậm to – kiểu tạp chí.",
   "capcut": "2 lớp: viết tay vàng/trắng + Montserrat Bold/Anton; vào lệch 0,2s."
  },
  "7": {
   "ten": "In hoa đậm viền đen",
   "mo_ta": "Chữ trắng rất to, viền đen dày – kiểu ảnh bìa, đọc từ xa.",
   "capcut": "Anton / Montserrat Bold trắng, Viền đen 8–12. Vào: Zoom Out."
  },
  "8": {
   "ten": "Chữ phồng dễ thương",
   "mo_ta": "Chữ tròn phồng pastel/màu tươi, viền trắng dày, sticker tim/lấp lánh.",
   "capcut": "Coiny màu pastel + Viền trắng dày + bóng; sticker từ kho Sticker CapCut. Vào: Bounce In."
  },
  "9": {
   "ten": "Số / giá cực to",
   "mo_ta": "Giá, số tiền, diện tích chiếm 1/3 khung, dòng phụ nhỏ.",
   "capcut": "Anton cỡ lớn, viền dày; dòng phụ vàng/viết tay. Vào: Zoom Out / Pop Up."
  },
  "10": {
   "ten": "Nhãn nền màu + tiêu đề",
   "mo_ta": "Nhãn nhỏ nền màu (loại SP, Ghé thăm) + tên to; hoặc khung màu bọc tiêu đề.",
